{
  "name": "reloop-material-workspace",
  "private": true,
  "version": "2.1.3",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "server": "node server/server.mjs",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node scripts/start.mjs",
    "test:api": "node --test test-api.mjs",
    "test:workflow": "node --test test-workflow.mjs",
    "test": "node --test test-api.mjs test-workflow.mjs test-release-tooling.mjs",
    "i18n:audit": "node scripts/audit-i18n.mjs",
    "i18n:check": "node scripts/audit-i18n.mjs --strict",
    "i18n:surface": "node scripts/audit-ui-text.mjs",
    "test:e2e": "playwright test",
    "test:quality": "npm test && npm run i18n:check && npm run i18n:surface",
    "test:release": "node --test test-release-tooling.mjs",
    "load:help": "node -e \"console.log('Read load/k6/README.md before using k6. Load tests require an authorized isolated HTTPS staging environment.')\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "@aws-sdk/client-s3": "^3.883.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0"
  }
}
