# Copy this file to .env. Keep .env private and never commit real secrets.
NODE_ENV=development
API_PORT=3001
# Production requires a PostgreSQL URL. Local dev can leave this empty to use JSON storage.
DATABASE_URL=
POSTGRES_DB=reloop
POSTGRES_USER=reloop_app
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-password
RELOOP_DOMAIN=app.example.com
PGSSLMODE=require
PG_POOL_MAX=5
APP_BASE_URL=http://localhost:5173
RELOOP_ALLOWED_ORIGINS=http://localhost:5173
REQUIRE_EMAIL_VERIFICATION=false
# Set a long, random secret for deployed environments (at least 32 random bytes).
RELOOP_SESSION_SECRET=replace-with-a-long-random-secret
# Optional: creates the first admin account at startup. Admin cannot self-register.
RELOOP_ADMIN_EMAIL=admin@example.com
RELOOP_ADMIN_PASSWORD=replace-with-a-unique-strong-password-at-least-16-chars
RELOOP_ADMIN_NAME=ReLoop Operations
# Optional email notifications via Resend HTTP API.
RESEND_API_KEY=
RELOOP_FROM_EMAIL=
# Optional payment integration. Use test keys first; keep secrets server-side only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Only set after the platform fee model and policy are approved. Amount is paise (e.g. 10000 = ₹100).
RELOOP_PLATFORM_FEE_PAISE=

# Configure a trusted business-verification provider/gateway to sign webhook bodies with this secret.
KYB_WEBHOOK_SECRET=
# Razorpay webhook secret from the Razorpay dashboard (different from API key secret).
RAZORPAY_WEBHOOK_SECRET=

# Optional AWS S3 private evidence storage. Leave empty to use local disk in development.
# Production should use an IAM role/task role; do not store AWS access keys in this file.
AWS_REGION=ap-south-1
RELOOP_S3_BUCKET=

# Optional open-source OpenSearch discovery for local demo; leave blank to use built-in search.
RELOOP_OPENSEARCH_URL=
