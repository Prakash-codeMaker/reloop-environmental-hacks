const roleMeta = {
  generator: { label:'Material generator', short:'Business', icon:Building2, nav:[['Overview',LayoutDashboard],['My listings',Package],['Offers',Handshake],['Collections',Truck],['Transactions',ClipboardCheck],['Verification',ShieldCheck],['Report an issue',AlertCircle]], primary:'List material' },
  buyer: { label:'Buyer / recycler', short:'Buyer', icon:Factory, nav:[['Overview',LayoutDashboard],['Find material',Search],['My sourcing',Boxes],['Collections',Truck],['Transactions',ClipboardCheck],['Verification',ShieldCheck],['Report an issue',AlertCircle]], primary:'Find material' },
  collector: { label:'Collector / logistics', short:'Collector', icon:Truck, nav:[['Overview',LayoutDashboard],['My pickups',Route],['Schedule',CalendarDays],['Completed jobs',CheckCheck],['Report an issue',AlertCircle],['Verification',ShieldCheck]], primary:'View pickups' },
  admin: { label:'Platform admin', short:'Admin', icon:ShieldCheck, nav:[['Overview',LayoutDashboard],['Transactions',ClipboardCheck],['Partners',Users],['Exceptions',AlertCircle],['Issues',MessageSquareText],['Audit log',FileText]], primary:'Review exceptions' },
};
const roleDescriptions = {
  generator:'List material, compare offers and keep every handover in one place.',
  buyer:'Find material that fits your sourcing requirements and manage incoming supply.',
  collector:'Manage assigned collections and record handovers from your phone.',
  admin:'Keep partner onboarding, transactions and exceptions moving reliably.'
};
function loadState(key, fallback) { try { const v=localStorage.getItem(key); return v?JSON.parse(v):fallback; } catch { return fallback; } }

async function apiRequest(path, options={}) {
  const response = await fetch(`/api${path}`, { credentials:'include', ...options, headers:{ ...(options.body ? {'Content-Type':'application/json'} : {}), ...(options.headers||{}) } });
  const data = await response.json().catch(()=>({}));
  if (!response.ok) { const error = new Error(data.error || `Request failed (${response.status})`); error.status=response.status; throw error; }
  return data;
}
function LiveLoading(){return <div className="auth-shell"><div className="auth-card loading-card"><div className="brand-lockup auth-brand"><div className="brand-mark"><Recycle size={21}/></div><div><div className="brand-name">reloop<span>.</span></div><div className="brand-caption">MATERIAL WORKSPACE</div></div></div><div className="loading-spinner"/><h1>{tr("Connecting to your workspace")}</h1><p>{tr("Loading your account and shared transaction records.")}</p></div></div>}
function AuthScreen({onAuthenticated,onBack,error:externalError,language="en",setLanguage=()=>{}}){
 const [tab,setTab]=useState('login'); const [businessName,setBusinessName]=useState(''); const [email,setEmail]=useState(''); const [password,setPassword]=useState(''); const [role,setRole]=useState(()=>loadState('reloop-auth-role','generator')); const [phone,setPhone]=useState(''); const [busy,setBusy]=useState(false); const [error,setError]=useState(''); const [notice,setNotice]=useState(''); const [resetToken,setResetToken]=useState(()=>{const token=new URLSearchParams(window.location.search).get('resetToken')||'';if(token)window.history.replaceState({},'',window.location.pathname);return token;});
 const chooseRole=(next)=>{setRole(next);localStorage.setItem('reloop-auth-role',JSON.stringify(next));setError('');};
 const submit=async(e)=>{e.preventDefault();setBusy(true);setError('');setNotice('');try{const path=resetToken?'/auth/reset-password':(tab==='login'?'/auth/login':'/auth/register');const body=resetToken?{token:resetToken,password}:(tab==='login'?{email,password,expectedRole:role}:{businessName,email,password,role,phone,language});const result=await apiRequest(path,{method:'POST',body:JSON.stringify(body)});if(resetToken){setResetToken('');window.history.replaceState({},'',window.location.pathname);setPassword('');setNotice(result.message||'Password updated. Sign in with your new password.');setTab('login');return;}if(result.verificationRequired){setNotice(result.message||'Check your email to verify your account before signing in.');setTab('login');return;}await onAuthenticated(result.user);}catch(err){if(tab==='register'&&err.status===409&&/account with this email already exists/i.test(err.message)){setTab('login');setPassword('');setError('');setNotice('An account with this email already exists. Sign in with your existing password, or use Forgot password if you cannot remember it.');}else{setError(err.message||'Unable to connect. Make sure the ReLoop server is running.')}}finally{setBusy(false)}};
 const requestReset=async()=>{setBusy(true);setError('');setNotice('');try{const result=await apiRequest('/auth/forgot-password',{method:'POST',body:JSON.stringify({email})});setNotice(result.message||'If the account exists, reset instructions will be sent.')}catch(err){setError(err.message)}finally{setBusy(false)}};
 const resendVerification=async()=>{setBusy(true);setError('');setNotice('');try{const result=await apiRequest('/auth/resend-verification',{method:'POST',body:JSON.stringify({email})});setNotice(result.message||'If the account needs verification, a new email will be sent.')}catch(err){setError(err.message)}finally{setBusy(false)}};
 return <div className="auth-shell"><div className="auth-card"><div className="brand-lockup auth-brand"><div className="brand-mark"><Recycle size={21}/></div><div><div className="brand-name">reloop<span>.</span></div><div className="brand-caption">MATERIAL WORKSPACE</div></div><label className="language-control auth-language"><Languages size={15}/><span className="sr-only">Language</span><select aria-label="Language" value={language} onChange={e=>setLanguage(e.target.value)}>{LANGUAGES.map(x=><option key={x.value} value={x.value}>{x.label}</option>)}</select></label><button className="text-button auth-back" onClick={onBack}>{tr("Return to demo",language)}</button></div><div className="auth-intro"><div className="eyebrow">{tr("SHARED WORKSPACE",language)}</div><h1>{tr(resetToken?'Choose a new password.':tab==='login'?'Welcome back.':'Create your business workspace.',language)}</h1><p>{tr(resetToken?'Use a new password of at least 12 characters.':tab==='login'?'Sign in to access shared listings, offers and transaction records.':'Create an account to start coordinating recyclable material with other participants.',language)}</p></div>{!resetToken&&<div className="auth-tabs"><button className={tab==='login'?'active':''} onClick={()=>{setTab('login');setError('');setNotice('')}}>{tr('Sign in',language)}</button><button className={tab==='register'?'active':''} onClick={()=>{setTab('register');setError('');setNotice('')}}>{tr('Create account',language)}</button></div>}{tab==='login'&&!resetToken&&<div className="signin-role-note"><strong>{tr("Choose your workspace",language)}</strong><span>Your account belongs to one role. You will only see that role's dashboard and actions. Administrator access is available only to provisioned admin accounts.</span><div className="signin-role-options">{[['generator','Material generator'],['buyer','Buyer / recycler'],['collector','Collector / logistics'],['admin','Platform administrator']].map(([value,label])=><button type="button" key={value} className={role===value?'selected':''} onClick={()=>chooseRole(value)} aria-pressed={role===value}>{tr(label,language)}</button>)}</div></div>}<form onSubmit={submit} className="auth-form">{tab==='register'&&!resetToken&&<><label className="field"><span>{tr("Business or organization name",language)} *</span><input required maxLength={120} value={businessName} onChange={e=>setBusinessName(e.target.value)} placeholder="e.g. Northstar Retail"/></label><label className="field"><span>{tr("Your role",language)} *</span><select value={role} onChange={e=>chooseRole(e.target.value)}><option value="generator">{tr("Business generating material",language)}</option><option value="buyer">{tr("Buyer / recycler",language)}</option><option value="collector">{tr("Collector / logistics",language)}</option></select><small className="role-verification-hint">{role==='generator'?'Verification: confirm email and submit business or material-source evidence if requested.':role==='buyer'?'Verification: confirm email and provide relevant business or buyer-capability evidence.':'Verification: confirm email and provide identity plus vehicle or transport details when applicable.'}</small></label><label className="field"><span>{tr("Phone (optional)",language)}</span><input value={phone} onChange={e=>setPhone(e.target.value)} maxLength={30} placeholder={tr("Business contact number")}/></label></>}{!resetToken&&<label className="field"><span>{tr("Business email *",language)}</span><input required type="email" autoComplete="email" value={email} onChange={e=>setEmail(e.target.value)} placeholder="you@company.com"/></label>}<label className="field"><span>{tr(resetToken?'New password *':'Password *',language)} {(tab==='register'||resetToken)&&<small>(at least {resetToken?'12':'10'} characters)</small>}</span><input required type="password" minLength={resetToken?12:tab==='register'?10:1} autoComplete={tab==='login'?'current-password':'new-password'} value={password} onChange={e=>setPassword(e.target.value)} placeholder={resetToken?'Create a new strong password':tab==='register'?'Create a strong password':'Enter your password'}/></label>{(error||externalError)&&<div className="auth-error" role="alert"><AlertCircle size={16}/>{error||externalError}</div>}{notice&&<div className="auth-notice" role="status">{notice}</div>}{!resetToken&&tab==='login'&&error.toLowerCase().includes('verify your email')&&<button type="button" className="text-button" disabled={busy||!email} onClick={resendVerification}>{tr("Resend verification email")}</button>}<button className="button primary full-width auth-submit" disabled={busy}>{busy?'Please wait…':resetToken?'Reset password':tab==='login'?tr('Sign in to ReLoop',language):tr('Create workspace',language)} <ArrowRight size={16}/></button>{tab==='login'&&!resetToken&&<button type="button" className="text-button" disabled={busy||!email} onClick={requestReset}>{tr("Forgot password? Send reset instructions",language)}</button>}</form><div className="auth-note"><ShieldCheck size={15}/><span>{tr("Business verification is handled separately. Creating an account does not mean the business is verified.")}</span></div></div><div className="auth-footer">© 2026 ReLoop · Material coordination workspace</div></div>
}


function VerificationPanel({user,notify,liveMode=true}){
 const [documents,setDocuments]=useState([]);const [documentType,setDocumentType]=useState('');const [file,setFile]=useState(null);const [busy,setBusy]=useState(false);const [error,setError]=useState('');
 const roleDocs={
  generator:[['business_registration','Business registration'],['tax_document','Tax document'],['address_proof','Business address proof'],['material_source_proof','Material-source declaration or evidence'],['other','Other supporting document']],
  buyer:[['business_registration','Business registration'],['tax_document','Tax document'],['address_proof','Business address proof'],['buyer_authorization','Purchasing authorization'],['processing_capability','Processing capability evidence'],['other','Other supporting document']],
  collector:[['identity_proof','Responsible person identity document'],['address_proof','Address proof'],['vehicle_document','Vehicle document'],['transport_permit','Transport permit (if applicable)'],['other','Other supporting document']]
 };
 const roleNames={generator:{org:'Business identity',role:'Material-source profile',intro:'Confirm the business contact and provide a relevant document. Small businesses should only submit documents that apply to them.'},buyer:{org:'Business identity',role:'Buyer capability',intro:'Confirm the organization and provide relevant purchasing or processing information.'},collector:{org:'Identity and contact',role:'Collection capability',intro:'Confirm the responsible person and provide vehicle or transport evidence when applicable.'}};
 const cfg=roleNames[user?.role]||roleNames.generator;const options=roleDocs[user?.role]||roleDocs.generator;
 useEffect(()=>{if(!liveMode)return;setDocumentType(options[0]?.[0]||'other');refresh()},[liveMode,user?.id]);
 const refresh=async()=>{try{const data=await apiRequest('/verification/evidence');setDocuments(data.evidence||[])}catch(err){setError(err.message)}};
 const baseChecks=user?.verificationChecks||[
  {key:'contact',label:'Email contact',status:user?.emailVerified?'verified':'pending',detail:user?.emailVerified?'Email address confirmed':'Confirm your email address'},
  {key:'organization',label:cfg.org,status:user?.verificationStatus==='verified'?'verified':'pending',detail:'Submit one relevant document for review'},
  {key:'role',label:cfg.role,status:user?.verificationStatus==='verified'?'verified':'pending',detail:'Role-specific checks may be required'}
 ];
 const orgTypes={generator:['business_registration','tax_document','address_proof'],buyer:['business_registration','tax_document','address_proof'],collector:['identity_proof','address_proof']};const roleTypes={generator:['material_source_proof'],buyer:['buyer_authorization','processing_capability'],collector:['vehicle_document','transport_permit']};
 const checks=baseChecks.map(check=>{if(user?.verificationStatus==='verified')return {...check,status:'verified'};if(user?.verificationStatus==='rejected')return {...check,status:'rejected'};if(check.key==='organization'&&documents.some(d=>(orgTypes[user?.role]||[]).includes(d.documentType)))return {...check,status:'in_review',detail:'Supporting document submitted'};if(check.key==='role'&&documents.some(d=>(roleTypes[user?.role]||[]).includes(d.documentType)))return {...check,status:'in_review',detail:'Role-specific evidence submitted'};return check;});
 const upload=async()=>{if(!file){setError('Choose a JPG, PNG or PDF document first.');return}if(file.size>6*1024*1024){setError('Choose a file smaller than 6 MB.');return}setBusy(true);setError('');try{const dataBase64=await new Promise((resolve,reject)=>{const r=new FileReader();r.onload=()=>resolve(String(r.result));r.onerror=()=>reject(new Error('Could not read the selected file.'));r.readAsDataURL(file)});await apiRequest('/verification/evidence',{method:'POST',body:JSON.stringify({filename:file.name,contentType:file.type,dataBase64,documentType})});setFile(null);await refresh();notify('Document submitted. ReLoop will show the review status here.');}catch(err){setError(err.message)}finally{setBusy(false)}};
 const statusLabel=s=>({verified:'Verified',in_review:'In review',rejected:'Needs attention',pending:'Pending'})[s]||'Pending';
 return <div className="verification-panel verification-panel-expanded"><div className="verification-heading"><ShieldCheck size={20}/><div><strong>Verification for your {user?.role==='generator'?'business':user?.role==='buyer'?'buyer account':'collection account'}</strong><p>{tr("Overall status:")}{' '}<span className={`status-pill ${user?.verificationStatus==='verified'?'completed':user?.verificationStatus==='rejected'?'cancelled':'pending'}`}><i/>{user?.verificationStatus||'pending'}</span></p></div></div><p className="muted-text">{cfg.intro} {tr("Contact verification and role checks are separate. Uploading a file never marks an account verified automatically.")}</p>
 <div className="verification-check-list">{checks.map((check,i)=><div className="verification-check" key={check.key}><div className={`verification-check-icon ${check.status==='verified'?'done':check.status==='rejected'?'issue':''}`}>{check.status==='verified'?<CheckCircle2 size={17}/>:check.status==='rejected'?<AlertCircle size={17}/>:check.status==='in_review'?<Clock3 size={17}/>:<span>{i+1}</span>}</div><div className="verification-check-copy"><strong>{check.label}</strong><small>{check.detail}</small></div><span className={`verification-state ${check.status}`}>{statusLabel(check.status)}</span></div>)}</div>
 {liveMode&&user?.verificationStatus!=='verified'&&<><div className="verification-upload-title"><strong>{tr("Submit supporting information")}</strong><span>JPG, PNG or PDF · up to 6 MB</span></div><label className="field"><span>{tr("What are you submitting?")}</span><select value={documentType} onChange={e=>setDocumentType(e.target.value)}>{options.map(([value,label])=><option value={value} key={value}>{label}</option>)}</select></label><label className="field"><span>{tr("Document file")}</span><input type="file" accept="image/jpeg,image/png,application/pdf" onChange={e=>setFile(e.target.files?.[0]||null)}/></label>{error&&<div className="auth-error" role="alert">{error}</div>}<button className="button primary full-width" disabled={busy||!file} onClick={upload}>{busy?'Submitting securely…':'Submit for review'} <ArrowRight size={15}/></button></>}
 <div className="verification-documents"><strong>{tr("Submitted documents")}</strong>{documents.length?documents.map(d=><div className="verification-doc-row" key={d.id}><FileText size={15}/><span>{d.filename}<small>{(options.find(o=>o[0]===d.documentType)?.[1]||d.documentType.replaceAll('_',' '))} · {new Date(d.createdAt).toLocaleDateString(languageLocale(detectLanguage()))}</small></span><span className="verification-state in_review">Submitted</span></div>):<p className="muted-text">{tr("No documents submitted yet.")}</p>}</div>
 <div className="verification-privacy"><ShieldCheck size={16}/><span>Documents are visible only to authorized ReLoop reviewers. Do not upload unrelated personal information. Actual verification depends on configured email and review providers.</span></div>
 </div>
}
function VerificationPage({user,role,liveMode,notify,onGoLive}){
 const demoChecks={generator:[['Email contact','verified','Email address confirmed'],['Business identity','in_review','Sample business document submitted'],['Material-source profile','pending','Role-specific review pending']],buyer:[['Email contact','verified','Email address confirmed'],['Business identity','in_review','Sample business document submitted'],['Buyer capability','pending','Purchasing or processing review pending']],collector:[['Email contact','verified','Email address confirmed'],['Identity and contact','in_review','Sample identity record submitted'],['Collection capability','pending','Operator or vehicle review pending']]};
 const labels={generator:'Material generator',buyer:'Buyer / recycler',collector:'Collector / logistics'};
 return <><PageHeading eyebrow="ACCOUNT TRUST" title={tr("Verification")} description="See what has been checked, what is still pending, and the next step for your role."/>{liveMode?<VerificationPanel user={user} notify={notify} liveMode/>:<><div className="verification-demo-callout"><ShieldCheck size={19}/><div><strong>{tr("Demo verification journey")}</strong><p>{tr("These are illustrative states only. In a live workspace, statuses come from email verification and reviewed evidence.")}</p></div></div><div className="verification-check-list verification-demo-list">{(demoChecks[role]||demoChecks.generator).map(([label,status,detail],i)=><div className="verification-check" key={label}><div className={`verification-check-icon ${status==='verified'?'done':''}`}>{status==='verified'?<CheckCircle2 size={17}/>:<span>{i+1}</span>}</div><div className="verification-check-copy"><strong>{label}</strong><small>{detail}</small></div><span className={`verification-state ${status}`}>{status==='verified'?'Verified':status==='in_review'?'In review':'Pending'}</span></div>)}</div><div className="notice-strip"><ShieldCheck size={18}/><span><strong>{labels[role]||'Account'} checks are role-specific.</strong> {tr("Demo states do not verify a real identity or business. Switch to the shared workspace to test the account workflow.")}</span></div><button className="button primary" onClick={onGoLive}>{tr("Continue to shared workspace")}{' '}<ArrowRight size={15}/></button></>}</>
}
function App(){
  const [language,setLanguageState]=useState(()=>detectLanguage());
  const setLanguage=(next)=>{setLanguageState(next);try{localStorage.setItem('reloop-language',next)}catch{};if(workspaceMode==='live'&&session?.id)apiRequest('/profile/language',{method:'PATCH',body:JSON.stringify({language:next})}).catch(()=>{});};
  const [isOnline,setIsOnline]=useState(()=>typeof navigator==='undefined'?true:navigator.onLine);
  useEffect(()=>{
    document.documentElement.lang=languageLocale(language);
    document.documentElement.dataset.locale=language;
    document.documentElement.dir='ltr';
  },[language]);
  useEffect(()=>{
    const syncLanguage=(event)=>{
      if(event.key!=='reloop-language'||!event.newValue)return;
      if(LANGUAGES.some(item=>item.value===event.newValue))setLanguageState(event.newValue);
    };
    window.addEventListener('storage',syncLanguage);
    return()=>window.removeEventListener('storage',syncLanguage);
  },[]);
  useEffect(()=>{const on=()=>setIsOnline(true),off=()=>setIsOnline(false);window.addEventListener('online',on);window.addEventListener('offline',off);return()=>{window.removeEventListener('online',on);window.removeEventListener('offline',off)}},[]);
  const [role,setRole]=useState(()=>loadState('reloop-demo-v2-role','generator'));
  const [batches,setBatches]=useState(()=>loadState('reloop-demo-v2-batches',initialBatches));
  const [offers,setOffers]=useState(()=>loadState('reloop-demo-v2-offers',initialOffers));
  const [page,setPage]=useState('Overview');
  const [search,setSearch]=useState('');
  const [filter,setFilter]=useState('All materials');
  const [modal,setModal]=useState(null);
  const [activeBatch,setActiveBatch]=useState(null);
  const [toast,setToast]=useState('');
  const [mobileNav,setMobileNav]=useState(false);
  const [notificationsOpen,setNotificationsOpen]=useState(false);
  const [profileOpen,setProfileOpen]=useState(false);
  const [showDemo,setShowDemo]=useState(true);
  const [workspaceMode,setWorkspaceMode]=useState(()=>{const query=new URLSearchParams(window.location.search);return query.get('workspace')==='live'||query.has('resetToken')?'live':loadState('reloop-mode','demo')});
  const [session,setSession]=useState(null);
  const [liveLoading,setLiveLoading]=useState(false);
  const [liveError,setLiveError]=useState('');
  const [notifications,setNotifications]=useState([]);
  const [unreadCount,setUnreadCount]=useState(0);
  const [liveMatches,setLiveMatches]=useState(null);
  useEffect(()=>{localStorage.setItem('reloop-mode',JSON.stringify(workspaceMode));},[workspaceMode]);
  useEffect(()=>{if(workspaceMode==='demo'){localStorage.setItem('reloop-demo-v2-role',JSON.stringify(role));localStorage.setItem('reloop-demo-v2-batches',JSON.stringify(batches));localStorage.setItem('reloop-demo-v2-offers',JSON.stringify(offers));}},[role,batches,offers,workspaceMode]);
  useEffect(()=>{if(!toast)return;const t=setTimeout(()=>setToast(''),3200);return()=>clearTimeout(t)},[toast]);
  useEffect(()=>{
    const heading=document.querySelector('.main-area .page-heading h1, .main-area .welcome-strip h1');
    if(!heading)return;
    heading.setAttribute('tabindex','-1');
    heading.focus({preventScroll:true});
  },[page]);
  const refreshLiveWorkspace=async()=>{const data=await apiRequest('/workspace');setSession(data.user);setRole(data.user.role);setBatches(data.batches||[]);setOffers(data.offers||[]);setNotifications(data.notifications||[]);setUnreadCount(data.unreadCount||0);};
  useEffect(()=>{if(workspaceMode!=='live')return;let cancelled=false;setLiveLoading(true);setLiveError('');(async()=>{try{const me=await apiRequest('/auth/me');const data=await apiRequest('/workspace');if(!cancelled){setSession(me.user);if(me.user.language){setLanguageState(me.user.language);try{localStorage.setItem('reloop-language',me.user.language)}catch{}}setRole(me.user.role);setBatches(data.batches||[]);setOffers(data.offers||[]);setNotifications(data.notifications||[]);setUnreadCount(data.unreadCount||0);}}catch(err){if(!cancelled){setSession(null);if(err.status!==401)setLiveError(err.message||'Cannot reach the ReLoop API.');}}finally{if(!cancelled)setLiveLoading(false);}})();return()=>{cancelled=true};},[workspaceMode]);
  useEffect(()=>{if(workspaceMode!=='live'||!session)return;const timer=setInterval(()=>{refreshLiveWorkspace().catch(()=>{});},30000);return()=>clearInterval(timer);},[workspaceMode,session?.id]);
  useEffect(()=>{if(workspaceMode!=='live'||role!=='buyer'||page!=='Find material'){setLiveMatches(null);return}let cancelled=false;const params=new URLSearchParams();if(filter!=='All materials')params.set('category',filter);if(search.trim())params.set('q',search.trim());apiRequest(`/matches?${params.toString()}`).then(d=>{if(!cancelled)setLiveMatches((d.matches||[]).map(x=>({...x.batch,matchScore:x.score,matchReasons:x.reasons}))) }).catch(()=>{if(!cancelled)setLiveMatches([])});return()=>{cancelled=true};},[workspaceMode,role,page,filter,search,session?.id]);
  const handleAuthenticated=async(user)=>{if(user.language){setLanguageState(user.language);try{localStorage.setItem('reloop-language',user.language)}catch{}}else if(language!=='en'){apiRequest('/profile/language',{method:'PATCH',body:JSON.stringify({language})}).catch(()=>{})}setRole(user.role);setLiveError('');setLiveLoading(true);try{const data=await apiRequest('/workspace');setSession(data.user);setRole(data.user.role);setBatches(data.batches||[]);setOffers(data.offers||[]);setNotifications(data.notifications||[]);setUnreadCount(data.unreadCount||0);}catch(err){setLiveError(err.message);throw err;}finally{setLiveLoading(false);}};
  const logout=async()=>{try{await apiRequest('/auth/logout',{method:'POST'});}catch{}setSession(null);setRole('generator');setBatches([]);setOffers([]);setNotifications([]);setUnreadCount(0);setProfileOpen(false);};
  const returnToDemo=()=>{setRole(loadState('reloop-demo-v2-role','generator'));setBatches(loadState('reloop-demo-v2-batches',initialBatches));setOffers(loadState('reloop-demo-v2-offers',initialOffers));setSession(null);setNotifications([]);setUnreadCount(0);setLiveMatches(null);setLiveError('');setPage('Overview');setSearch('');setFilter('All materials');setProfileOpen(false);setWorkspaceMode('demo');};
  const meta=roleMeta[role];
  const listingDefaultsKey=workspaceMode==='live'&&session?.id?`reloop-listing-defaults:${session.id}`:'reloop-listing-defaults:demo';
  const pendingOffers=offers.filter(o=>o.status==='Pending').length;
  const activeBatches=batches.filter(b=>!['Completed','Cancelled'].includes(b.status));
  const roleBatches=useMemo(()=>{
    if(role==='generator') return batches;
    if(role==='buyer') return batches.filter(b=>b.status!=='Completed');
    if(role==='collector') return batches.filter(b=>['Collection scheduled','Collected','Offer accepted'].includes(b.status)||b.collector!=='—');
    return batches;
  },[batches,role]);
  if(workspaceMode==='live'&&!session){if(liveLoading)return <LiveLoading/>;return <AuthScreen onAuthenticated={handleAuthenticated} onBack={returnToDemo} error={liveError} language={language} setLanguage={setLanguage}/>;}
  const sourceBatches=(workspaceMode==='live'&&role==='buyer'&&page==='Find material'&&liveMatches!==null)?liveMatches:roleBatches;
  const visibleBatches=sourceBatches.filter(b=>{
    const q=search.toLowerCase(); const matchQ=!q||[b.id,b.material,b.location,b.seller,b.status].join(' ').toLowerCase().includes(q);
    const matchF=filter==='All materials'||b.category===filter;
    const matchP=page==='My listings'?role==='generator':page==='Find material'?role==='buyer'&&b.status!=='Completed':page==='My pickups'?role==='collector'&&['Collection scheduled','Collected'].includes(b.status):page==='Schedule'?role==='collector'&&b.status==='Collection scheduled':page==='Completed jobs'?role==='collector'&&b.status==='Completed':page==='Collections'?['Collection scheduled','Collected'].includes(b.status):page==='Transactions'?b.status==='Completed':page==='Exceptions'?['Disputed','Needs review'].includes(b.status):true;
    return matchQ&&matchF&&matchP;
  });
  const notify=(message)=>setToast(translateMessage(message,language));
  const changeRole=(next)=>{if(workspaceMode==='live')return;setRole(next);setPage('Overview');setSearch('');setFilter('All materials');setMobileNav(false);setProfileOpen(false);notify(`Switched to ${roleMeta[next].label} workspace`)};
  const updateBatch=async(id,patch)=>{
    if(workspaceMode==='live'){try{const result=await apiRequest(`/batches/${encodeURIComponent(id)}`,{method:'PATCH',body:JSON.stringify(patch)});setBatches(prev=>prev.map(b=>b.id===id?{...b,...result.batch}:b));return result.batch;}catch(err){notify(err.message);throw err;}}
    setBatches(prev=>prev.map(b=>b.id===id?{...b,...patch}:b));return {...batches.find(b=>b.id===id),...patch};
  };
  const updateOffer=async(id,status,details={})=>{
    if(workspaceMode==='live'){
      try{let result;if(status==='create'){result=await apiRequest(`/batches/${encodeURIComponent(id)}/offers`,{method:'POST',body:JSON.stringify(details)});notify('Offer submitted to the material owner.');}else{result=await apiRequest(`/offers/${encodeURIComponent(id)}`,{method:'PATCH',body:JSON.stringify({status})});notify(`Offer ${status.toLowerCase()}.`);}await refreshLiveWorkspace();setModal(null);return result;}catch(err){notify(err.message);throw err;}
    }
    if(status==='create'){
      const batch=batches.find(b=>b.id===id);if(!batch){notify('This batch is no longer available. Refresh and try again.');return;}
      const nextOfferNumber=Math.max(208,...offers.map(o=>Number(String(o.id).replace('OF-',''))||0))+1;
      const created={id:`OF-${nextOfferNumber}`,batchId:id,buyer:'Pune Fibre Works (demo)',price:Number(details.price),unit:batch.unit||'kg',pickup:details.pickup||'Flexible — agree with seller',note:String(details.note||'').trim()||'No additional conditions provided.',status:'Pending',rating:'Demo participant'};
      setOffers(prev=>[created,...prev]);
      setBatches(prev=>prev.map(b=>b.id===id&&b.status==='Listed'?{...b,status:'Offer received'}:b));
      setModal(null);notify(`Demo offer created at ₹${Number(details.price).toFixed(2)}/${batch.unit||'kg'}. It is saved in this browser only, not sent to a real seller.`);return created;
    }
    const offer=offers.find(o=>o.id===id); if(!offer)return;
    setOffers(prev=>prev.map(o=>o.id===id?{...o,status}:o));
    if(status==='Accepted') { setBatches(prev=>prev.map(b=>b.id===offer.batchId?{...b,status:'Collection scheduled',price:offer.price,collector:'GreenRoute Collection'}:b)); notify(`Offer accepted. ${offer.buyer} has been selected.`); }
    else notify(`Offer ${status.toLowerCase()}.`);
    setModal(null);
  };
  const addBatch=async(data)=>{
    if(workspaceMode==='live'){
      try{const result=await apiRequest('/batches',{method:'POST',body:JSON.stringify(data)});setBatches(prev=>[result.batch,...prev]);setModal(null);setPage('My listings');notify('Material listing published to the shared workspace.');return;}catch(err){notify(err.message);throw err;}
    }
    const newId=`RL-${Math.max(1043,...batches.map(b=>Number(b.id.replace('RL-',''))+1))}`;
    const batch={...data,id:newId,status:'Listed',seller:'Your business',date:'Just now',price:null,photo:data.category==='Paper'?'paper':data.category==='Plastic'?'plastic':'cardboard',collector:'—',actualWeight:null};
    setBatches(prev=>[batch,...prev]); setModal(null);setPage('My listings');notify('Your material listing is saved in the demo workspace.');
  };
  const uploadEvidence=async(batchId,file)=>{if(workspaceMode!=='live')return;const dataBase64=await new Promise((resolve,reject)=>{const reader=new FileReader();reader.onload=()=>resolve(String(reader.result));reader.onerror=()=>reject(new Error('Could not read the evidence file.'));reader.readAsDataURL(file)});await apiRequest(`/batches/${encodeURIComponent(batchId)}/evidence`,{method:'POST',body:JSON.stringify({filename:file.name,contentType:file.type,dataBase64})});};
  const markNotificationRead=async(n)=>{if(workspaceMode==='live'){try{await apiRequest(`/notifications/${encodeURIComponent(n.id)}/read`,{method:'POST'});setNotifications(prev=>prev.map(x=>x.id===n.id?{...x,readAt:new Date().toISOString()}:x));setUnreadCount(prev=>Math.max(0,prev-1));}catch{}}};
  const resetDemo=()=>{if(workspaceMode==='live')return;setBatches(initialBatches);setOffers(initialOffers);setSearch('');setFilter('All materials');notify('Demo data restored.');setProfileOpen(false)};
  const currentBatch=batches.find(b=>b.id===activeBatch);
  const activePageTitle=page==='Overview'?'Overview':page;
  return <div className="app-shell">
    <a className="skip-link" href="#main-content">Skip to main content</a>
    <aside className={`sidebar ${mobileNav?'sidebar-open':''}`}>
      <div className="brand-lockup"><div className="brand-mark"><Recycle size={21}/></div><div><div className="brand-name">reloop<span>.</span></div><div className="brand-caption">MATERIAL WORKSPACE</div></div><button className="icon-button sidebar-close" aria-label={tr("Close navigation")} onClick={()=>setMobileNav(false)}><X size={18}/></button></div>
      <div className="workspace-select"><div className="workspace-avatar"><meta.icon size={18}/></div><div className="workspace-copy"><span>{tr("WORKSPACE")}</span><strong>{tr(meta.label,language)}</strong></div><button className="icon-button tiny" aria-label="Switch workspace" onClick={()=>setProfileOpen(v=>!v)}><ChevronDown size={15}/></button></div>
      {profileOpen&&<div className="role-popover">{workspaceMode==='demo'?<><div className="role-popover-heading"><strong>{tr("Demo preview only",language)}</strong><span>Switch roles to preview separate journeys. These are not three permissions on one account.</span></div>{Object.entries(roleMeta).map(([key,r])=><button key={key} className={`role-option ${key===role?'selected':''}`} onClick={()=>changeRole(key)}><r.icon size={17}/><span>{r.label}</span>{key===role&&<Check size={15}/>}</button>)}<div className="popover-separator"/><button className="role-option" onClick={resetDemo}><RefreshCw size={16}/><span>{tr("Reset demo data",language)}</span></button><button className="role-option" onClick={()=>{setWorkspaceMode('live');setSession(null);setProfileOpen(false)}}><ShieldCheck size={16}/><span>{tr("Sign in to shared workspace",language)}</span></button></>:<><div className="role-option account-summary"><ShieldCheck size={17}/><span>{session?.email||'Signed in'}</span></div><button className="role-option" onClick={logout}><LogOut size={16}/><span>{tr("Sign out",language)}</span></button><button className="role-option" onClick={returnToDemo}><LayoutDashboard size={16}/><span>{tr("Return to demo",language)}</span></button></>}</div>}
      <div className="nav-label">{tr("WORKSPACE",language)}</div>
      <nav className="side-nav">{meta.nav.map(([label,Icon])=><button key={label} aria-current={page===label?'page':undefined} className={`nav-item ${page===label?'active':''}`} onClick={()=>{setPage(label);setMobileNav(false);setSearch('')}}><Icon size={18}/><span>{tr(label,language)}</span>{label==='Offers'&&role==='generator'&&pendingOffers>0&&<span className="nav-count">{pendingOffers}</span>}</button>)}</nav>
      <div className="sidebar-bottom"><div className="support-card"><div className="support-icon"><CircleHelp size={18}/></div><div><strong>{tr("Need a hand?",language)}</strong><span>{tr("Find your way around ReLoop.",language)}</span></div><button className="icon-button tiny" onClick={()=>setModal({type:'help'})} aria-label="Open help"><ArrowUpRight size={16}/></button></div><button className="nav-item muted" onClick={()=>setModal({type:'settings'})}><Settings2 size={18}/><span>{tr("Workspace settings",language)}</span></button><div className="user-row"><div className="user-avatar">{workspaceMode==='live'?(session?.businessName||'RL').slice(0,2).toUpperCase():role==='buyer'?'PF':role==='collector'?'GR':role==='admin'?'RL':'NS'}</div><div className="user-copy"><strong>{workspaceMode==='live'?(session?.businessName||session?.email||'Business account'):role==='buyer'?'Pune Fibre Works':role==='collector'?'GreenRoute Collection':role==='admin'?'ReLoop Operations':'Northstar Retail'}</strong><span>{meta.short} account · {workspaceMode==='demo'?'Demo':'Shared'}</span></div><button className="icon-button tiny" onClick={()=>setProfileOpen(v=>!v)} aria-label={tr("Open account menu")}><MoreHorizontal size={18}/></button></div></div>
    </aside>
    {mobileNav&&<button className="mobile-scrim" aria-label={tr("Close navigation")} onClick={()=>setMobileNav(false)}/>}
    <main className="main-area" id="main-content" tabIndex={-1}>
      <header className="topbar"><div className="topbar-left"><button className="icon-button mobile-menu" aria-label={tr("Open navigation")} onClick={()=>setMobileNav(true)}><Menu size={20}/></button><div className="breadcrumbs"><span>{tr("Workspace",language)}</span><ChevronRight size={14}/><strong>{tr(activePageTitle,language)}</strong></div></div><div className="topbar-actions"><label className="language-control top-language"><Languages size={15}/><span className="sr-only">{tr("Your language",language)}</span><select aria-label={tr("Your language",language)} value={language} onChange={e=>setLanguage(e.target.value)}>{LANGUAGES.map(x=><option key={x.value} value={x.value}>{x.label}</option>)}</select></label><button className="icon-button listen-button" title={tr("Listen to quick guide",language)} aria-label={tr("Listen to quick guide",language)} onClick={()=>{if(!('speechSynthesis' in window)){notify('Speech playback is not available in this browser.');return;}window.speechSynthesis.cancel();const guides={en:'Choose your role, list material, review offers, and record the actual weight after collection.',hi:'अपनी भूमिका चुनें, सामग्री सूचीबद्ध करें, ऑफ़र देखें और संग्रह पूरा होने पर वास्तविक वजन दर्ज करें।',mr:'तुमची भूमिका निवडा, साहित्य नोंदवा, ऑफर पाहा आणि संकलन पूर्ण झाल्यावर प्रत्यक्ष वजन नोंदवा.',gu:'તમારી ભૂમિકા પસંદ કરો, સામગ્રીની યાદી બનાવો, ઑફર તપાસો અને સંગ્રહ પછી વાસ્તવિક વજન નોંધો.',ta:'உங்கள் பங்கைத் தேர்ந்தெடுத்து, பொருளைப் பட்டியலிட்டு, சலுகைகளைப் பார்த்து, சேகரிப்புக்குப் பிறகு உண்மையான எடையைப் பதிவு செய்யுங்கள்.',te:'మీ పాత్రను ఎంచుకుని, మెటీరియల్ జాబితా చేసి, ఆఫర్లను పరిశీలించి, సేకరణ తర్వాత వాస్తవ బరువును నమోదు చేయండి.',kn:'ನಿಮ್ಮ ಪಾತ್ರವನ್ನು ಆಯ್ಕೆಮಾಡಿ, ವಸ್ತುವನ್ನು ಪಟ್ಟಿ ಮಾಡಿ, ಆಫರ್‌ಗಳನ್ನು ಪರಿಶೀಲಿಸಿ ಮತ್ತು ಸಂಗ್ರಹದ ನಂತರ ನಿಜವಾದ ತೂಕವನ್ನು ದಾಖಲಿಸಿ.'};const guide=guides[language]||guides.en;const utterance=new SpeechSynthesisUtterance(guide);utterance.lang=languageLocale(language);window.speechSynthesis.speak(utterance);}}><Volume2 size={17}/></button><button className={`environment-pill ${workspaceMode==='live'?'live':''}`} onClick={()=>{if(workspaceMode==='demo'){setWorkspaceMode('live');setSession(null);setLiveError('')}else{returnToDemo()}}} title={workspaceMode==='demo'?tr('Sign in to the shared workspace',language):tr('Return to demo workspace',language)}><span className="status-dot"/> {workspaceMode==='demo'?tr('Demo · Switch to live',language):tr('Shared workspace',language)}</button><div className="popover-anchor"><button className={`icon-button notification-button ${notificationsOpen?'pressed':''}`} aria-label={tr("Notifications")} onClick={()=>setNotificationsOpen(v=>!v)}><Bell size={18}/>{(workspaceMode==='live'?unreadCount:2)>0&&<i/>}</button>{notificationsOpen&&<div className="notifications-popover"><div className="popover-heading"><strong>{tr("Notifications",language)}</strong><span>{tr("Recent activity",language)}</span></div>{workspaceMode==='live'?(notifications.length?notifications.slice(0,5).map(n=><button className={`notification-line notification-action ${n.readAt?'read':''}`} key={n.id} onClick={()=>markNotificationRead(n)}><span className="notification-icon green"><Handshake size={16}/></span><div><strong>{n.title}</strong><p>{n.message}</p><small>{new Date(n.createdAt).toLocaleString(languageLocale(detectLanguage()))}</small></div></button>):<div className="notification-empty">{tr("You're all caught up.",language)}</div>):<><div className="notification-line"><span className="notification-icon green"><Handshake size={16}/></span><div><strong>New offer received</strong><p>Pune Fibre Works made an offer on RL-1042.</p><small>Just now · Demo activity</small></div></div><div className="notification-line"><span className="notification-icon amber"><Truck size={16}/></span><div><strong>Collection reminder</strong><p>RL-1039 is scheduled for today.</p><small>Today · Demo activity</small></div></div></>}<button className="text-button full-width" onClick={()=>{setNotificationsOpen(false);setPage(role==='generator'?'Offers':'Collections')}}>{tr("View relevant activity",language)} <ArrowRight size={14}/></button></div>}</div><button className="top-user" onClick={()=>setProfileOpen(v=>!v)}><span className="top-avatar">{workspaceMode==='live'?(session?.businessName||'RL').slice(0,2).toUpperCase():role==='buyer'?'PF':role==='collector'?'GR':role==='admin'?'RL':'NS'}</span><ChevronDown size={14}/></button></div></header>
      <div className="content-wrap">
        {!isOnline&&<div className="offline-banner" role="status"><WifiOff size={17}/><span>{tr("You are offline. Drafts stay on this device; submitting requires a connection.",language)}</span></div>}
        {showDemo&&<div className="demo-banner"><div className="demo-banner-icon"><Sparkles size={16}/></div><div><strong>{workspaceMode==='demo'?tr('Interactive product prototype',language):tr('Shared workspace · Live backend',language)}</strong><span>{workspaceMode==='demo'?'Demo only: role switching previews separate journeys. It does not grant multiple roles to a live account. Changes stay in this browser.':`Signed in as ${session?.businessName||session?.email}. Listings, offers and notifications are stored by the ReLoop API.`}</span></div><button className="icon-button tiny" onClick={()=>setShowDemo(false)} aria-label="Dismiss prototype notice"><X size={16}/></button></div>}
        {page==='Overview'?<Overview role={role} batches={batches} offers={offers} onPage={setPage} onAdd={()=>setModal({type:'newBatch'})} onBatch={b=>{setActiveBatch(b.id);setModal({type:'batch'})}} onOffer={()=>setPage('Offers')} onNotify={notify} onUpdateBatch={updateBatch} onUpdateOffer={updateOffer}/>:page==='Verification'&&role!=='admin'?<VerificationPage user={session} role={role} liveMode={workspaceMode==='live'} notify={notify} onGoLive={()=>{setWorkspaceMode('live');setSession(null);setLiveError('')}}/>:page==='Offers'&&role==='generator'?<OffersPage offers={offers} batches={batches} onBatch={b=>{setActiveBatch(b.id);setModal({type:'batch'})}} onAction={updateOffer}/>:page==='Partners'&&role==='admin'?<PartnersPage notify={notify} liveMode={workspaceMode==='live'}/>:page==='Audit log'&&role==='admin'?<AuditPage batches={batches} liveMode={workspaceMode==='live'}/>:((page==='Report an issue'&&role!=='admin')||(page==='Issues'&&role==='admin'))?<IssuePage liveMode={workspaceMode==='live'} role={role} user={session} batches={batches} notify={notify}/>:<ListPage role={role} page={page} batches={visibleBatches} search={search} setSearch={setSearch} filter={filter} setFilter={setFilter} onAdd={()=>setModal({type:'newBatch'})} onBatch={b=>{setActiveBatch(b.id);setModal({type:'batch'})}} onNotify={notify} onUpdateBatch={updateBatch} onUpdateOffer={updateOffer} offers={offers} onPage={setPage}/>}
        <footer className="app-footer"><span>© 2026 ReLoop · Material coordination workspace</span><span><ShieldCheck size={13}/> Built around clarity, traceability and trust</span></footer>
      </div>
    </main>
    {modal?.type==='newBatch'&&<NewBatchModal onClose={()=>setModal(null)} onSubmit={addBatch} template={modal.template||null} defaultsKey={listingDefaultsKey}/>}
    {modal?.type==='batch'&&currentBatch&&<BatchModal batch={currentBatch} role={role} liveMode={workspaceMode==='live'} onEvidence={uploadEvidence} offers={offers.filter(o=>o.batchId===currentBatch.id)} onClose={()=>setModal(null)} onUpdate={updateBatch} onOffer={updateOffer} onDuplicate={b=>setModal({type:'newBatch',template:b})} notify={notify}/>}
    {modal?.type==='help'&&<InfoModal title="ReLoop help" onClose={()=>setModal(null)}><p className="modal-lead">{tr("A clear path from material listing to confirmed handover.")}</p><div className="help-list"><div><PackagePlus size={18}/><span><strong>{tr("List material")}</strong><small>{tr("Add material type, estimated weight, location and condition.")}</small></span></div><div><Handshake size={18}/><span><strong>{tr("Review offers")}</strong><small>{tr("Compare commercial terms before accepting an offer.")}</small></span></div><div><ClipboardCheck size={18}/><span><strong>{tr("Confirm handover")}</strong><small>{tr("Record actual weight and evidence after collection.")}</small></span></div></div><button className="button primary full-width" onClick={()=>{setModal(null);setPage(role==='generator'?'My listings':role==='buyer'?'Find material':'My pickups')}}>{tr("Go to my work")}{' '}<ArrowRight size={16}/></button></InfoModal>}
    {modal?.type==='settings'&&<InfoModal title={tr("Workspace settings")} onClose={()=>setModal(null)}><p className="modal-lead">{workspaceMode==='demo'?'This workspace uses sample data stored in this browser.':'This workspace uses the ReLoop API and shared server-side records.'}</p><div className="setting-row"><span><strong>{tr("Current workspace")}</strong><small>{meta.label}</small></span><span className="setting-value">{workspaceMode==='demo'?'Demo':'Shared'}</span></div><div className="setting-row"><span><strong>{tr("Data storage")}</strong><small>{workspaceMode==='demo'?'Browser-local data, not shared.':'Server-side records for this running instance.'}</small></span><span className="setting-value">{workspaceMode==='demo'?'Local':'API'}</span></div>{workspaceMode==='demo'?<button className="button secondary full-width" onClick={resetDemo}><RefreshCw size={15}/> {tr("Restore sample data")}</button>:role!=='admin'&&<VerificationPanel user={session} notify={notify}/>}</InfoModal>}
    {toast&&<div className="toast" role="status" aria-live="polite" aria-atomic="true"><CheckCircle2 size={17}/>{toast}<button onClick={()=>setToast('')} aria-label="Dismiss message"><X size={15}/></button></div>}
  </div>
}
function PageHeading({eyebrow,title,description,action,actionLabel,actionIcon:ActionIcon=Plus}){return <div className="page-heading"><div><div className="eyebrow">{tr(eyebrow)}</div><h1>{tr(title)}</h1><p>{tr(description)}</p></div>{action&&<button className="button primary" onClick={action}><ActionIcon size={16}/>{tr(actionLabel)}</button>}</div>}
function StatCard({label,value,detail,icon:Icon,trend}){return <div className="stat-card"><div className="stat-top"><span>{tr(label)}</span><span className="stat-icon"><Icon size={18}/></span></div><div className="stat-value">{value}</div><div className="stat-detail">{trend&&<span className="stat-trend"><ArrowUpRight size={13}/>{tr(trend)}</span>}{tr(detail)}</div></div>}
function Overview({role,batches,offers,onPage,onAdd,onBatch,onOffer,onNotify,onUpdateBatch,onUpdateOffer}){
  const active=batches.filter(b=>!['Completed','Cancelled'].includes(b.status));const pending=offers.filter(o=>o.status==='Pending');const completed=batches.filter(b=>b.status==='Completed');
  const heading=tr(role==='generator'?'Good morning, Northstar.':role==='buyer'?'Good morning, Pune Fibre Works.':role==='collector'?'Your collection day.':'Operations overview');
  const subtitle=tr(roleDescriptions[role]);
  let stats=role==='generator'?[['Active listings',active.length,'Currently in the marketplace',Package],['Offers to review',pending.length,'Across your material batches',Handshake],['Collections pending',batches.filter(b=>b.status==='Collection scheduled').length,'Scheduled or awaiting pickup',Truck],['Completed transactions',completed.length,'Records available in history',ClipboardCheck]]:role==='buyer'?[['Available batches',batches.filter(b=>b.status==='Listed'||b.status==='Offer received').length,'Matching available supply',Boxes],['Offers sent',offers.filter(o=>o.buyer==='Pune Fibre Works').length,'Across sample listings',Handshake],['Collections scheduled',batches.filter(b=>b.status==='Collection scheduled').length,'Upcoming material receipts',Truck],['Completed sourcing',completed.length,'Completed sample transactions',ClipboardCheck]]:role==='collector'?[['Assigned pickups',batches.filter(b=>b.status==='Collection scheduled').length,'Jobs assigned to your team',Truck],['Due today',batches.filter(b=>b.status==='Collection scheduled').length,'Check schedule and access',CalendarDays],['Awaiting confirmation',batches.filter(b=>b.status==='Collected').length,'Handover record needed',Scale],['Completed jobs',completed.length,'Completed sample jobs',CheckCheck]]:[['Active batches',active.length,'Across current workflows',Boxes],['Offers pending',pending.length,'Require participant action',Handshake],['Completed records',completed.length,'In the sample workspace',ClipboardCheck],['Exceptions',batches.filter(b=>['Disputed','Needs review'].includes(b.status)).length,'Require admin review',AlertCircle]];
  return <>
    <div className="welcome-strip"><div><div className="eyebrow">{new Date().toLocaleDateString(languageLocale(language),{weekday:'long',day:'numeric',month:'long',year:'numeric'})}</div><h1>{heading}</h1><p>{subtitle}</p></div><div className="welcome-art"><div className="orbit orbit-one"/><div className="orbit orbit-two"/><div className="leaf-disc"><Leaf size={29}/></div><span className="art-dot dot-one"/><span className="art-dot dot-two"/></div></div>
    <div className="stat-grid">{stats.map(([label,value,detail,Icon],i)=><StatCard key={label} label={label} value={String(value).padStart(2,'0')} detail={detail} icon={Icon} trend={i===0&&role==='generator'?'Live view':''}/>)}</div>
    <div className="section-heading"><div><h2>{tr(role==='collector'?'Your next pickups':role==='buyer'?'Material worth reviewing':role==='admin'?'Platform activity':'Needs your attention')}</h2><p>{role==='generator'?'The next steps to keep your material moving.':role==='buyer'?'Relevant batches and sourcing activity.':role==='collector'?'Jobs assigned to your collection team.':'A snapshot of activity in the demo workspace.'}</p></div><button className="text-button" onClick={()=>onPage(role==='generator'?'My listings':role==='buyer'?'Find material':role==='collector'?'My pickups':'Transactions')}>{tr("View all")} <ArrowRight size={15}/></button></div>
    <div className="overview-grid"><div className="panel work-panel"><div className="panel-header"><div><h3>{role==='generator'?'Recent material':role==='buyer'?'Available batches':role==='collector'?'Assigned jobs':'Recent transactions'}</h3><span>Current workspace records</span></div><button className="icon-button" aria-label="View more records" onClick={()=>onPage(role==='generator'?'My listings':role==='buyer'?'Find material':role==='collector'?'My pickups':'Transactions')}><ArrowUpRight size={17}/></button></div><div className="batch-list">{(role==='collector'?batches.filter(b=>b.status==='Collection scheduled'||b.status==='Collected'):role==='buyer'?batches.filter(b=>b.status!=='Completed'):batches).slice(0,4).map(b=><BatchRow key={b.id} batch={b} role={role} onClick={()=>onBatch(b)}/>)}</div><div className="panel-bottom-link"><button className="text-button" onClick={()=>onPage(role==='generator'?'My listings':role==='buyer'?'Find material':role==='collector'?'My pickups':'Transactions')}>Open workspace list <ArrowRight size={15}/></button></div></div>
      <div className="right-column"><div className="panel attention-panel"><div className="panel-header"><div><h3>{role==='generator'?'Action required':role==='buyer'?'Sourcing shortcuts':role==='collector'?'Collection checklist':'Admin actions'}</h3><span>{role==='generator'?'Keep work moving':role==='buyer'?'Find the right supply':role==='collector'?'Close the loop':'Keep operations healthy'}</span></div><span className="soft-icon"><Activity size={17}/></span></div>{role==='generator'?<><ActionLine icon={Handshake} title={tr("Review new offers")} detail={`${pending.length} offers awaiting a decision`} onClick={onOffer}/><ActionLine icon={PackagePlus} title={tr("List another batch")} detail="Reuse your usual business details" onClick={onAdd}/><ActionLine icon={ClipboardCheck} title="Check completed records" detail="Review weight and handover details" onClick={()=>onPage('Transactions')}/></>:role==='buyer'?<><ActionLine icon={Search} title="Browse available material" detail="Filter by type, quantity and location" onClick={()=>onPage('Find material')}/><ActionLine icon={Handshake} title={tr("Review your sourcing")} detail="Track offers and accepted batches" onClick={()=>onPage('My sourcing')}/><ActionLine icon={ClipboardCheck} title={tr("Open transaction history")} detail="Find completed sourcing records" onClick={()=>onPage('Transactions')}/></>:role==='collector'?<><ActionLine icon={Truck} title={tr("Open assigned pickups")} detail="Check access details and schedule" onClick={()=>onPage('My pickups')}/><ActionLine icon={Scale} title={tr("Record a handover")} detail="Confirm actual weight and evidence" onClick={()=>onPage('My pickups')}/><ActionLine icon={CheckCheck} title={tr("View completed jobs")} detail="Review your recent collection history" onClick={()=>onPage('Completed jobs')}/></>:<><ActionLine icon={AlertCircle} title={tr("Review exceptions")} detail="Find disputed or incomplete records" onClick={()=>onPage('Exceptions')}/><ActionLine icon={Users} title={tr("Manage partner profiles")} detail="Review onboarding and role access" onClick={()=>onPage('Partners')}/><ActionLine icon={FileText} title={tr("Inspect audit history")} detail="Review recorded workflow activity" onClick={()=>onPage('Audit log')}/></>}</div>
      <div className="trust-card"><div className="trust-symbol"><ShieldCheck size={20}/></div><div><strong>{tr("Built for accountable handovers")}</strong><p>{tr("Keep material, offer, weight and collection records connected in one place.")}</p><button className="text-button" onClick={()=>onNotify('Traceability is demonstrated with sample data in this prototype.')}>{tr("How records work")}{' '}<ArrowRight size={14}/></button></div></div></div></div>
  </>
}
function ActionLine({icon:Icon,title,detail,onClick}){return <button className="action-line" onClick={onClick}><span className="action-line-icon"><Icon size={17}/></span><span className="action-line-copy"><strong>{tr(title)}</strong><small>{tr(detail)}</small></span><ChevronRight size={16} className="action-chevron"/></button>}
function BatchRow({batch,role,onClick}){return <button className="batch-row" onClick={onClick}><MaterialThumb type={batch.photo||'cardboard'}/><div className="batch-main"><div className="batch-title-line"><strong>{batch.material}</strong><span className="batch-id">{batch.id}</span></div><div className="batch-meta"><span><MapPin size={12}/>{batch.location}</span><span><Scale size={12}/>{batch.quantity} {batch.unit}</span></div></div><div className="batch-end"><StatusPill status={batch.status}/><span className="batch-date">{batch.date}</span></div><ChevronRight size={16} className="row-chevron"/></button>}
function MaterialThumb({type}){return <div className={`material-thumb ${type||'cardboard'}`}>{type==='paper'?<FileText size={21}/>:type==='plastic'?<Package size={21}/>:<Boxes size={21}/>}</div>}
function StatusPill({status}){let cls=status==='Completed'?'completed':status==='Listed'?'listed':status==='Offer received'||status==='Pending'?'pending':status==='Collection scheduled'||status==='Accepted'?'scheduled':status==='Collected'?'collected':status==='Cancelled'?'cancelled':'neutral';return <span className={`status-pill ${cls}`}><i/>{tr(status)}</span>}
function OffersPage({offers,batches,onBatch,onAction}){const [tab,setTab]=useState('Pending');const list=offers.filter(o=>tab==='All'||o.status===tab);return <><PageHeading eyebrow="COMMERCIAL TERMS" title={tr("Offers")} description="Compare offers against your material listings and choose the terms that work for your business."/><div className="tab-row">{['Pending','Accepted','Declined','All'].map(t=><button key={t} className={`tab-button ${tab===t?'active':''}`} onClick={()=>setTab(t)}>{t}<span>{offers.filter(o=>t==='All'||o.status===t).length}</span></button>)}</div><div className="panel offers-panel"><div className="table-wrap"><table><thead><tr><th>{tr("Buyer & batch")}</th><th>{tr("Offer rate")}</th><th>{tr("Collection")}</th><th>{tr("Status")}</th><th><span className="sr-only">{tr("Actions")}</span></th></tr></thead><tbody>{list.map(o=>{const b=batches.find(x=>x.id===o.batchId);return <tr key={o.id}><td><div className="table-primary">{o.buyer}</div><button className="table-sub-link" onClick={()=>b&&onBatch(b)}>{b?.material||o.batchId} · {o.batchId}</button><div className="verified-note"><ShieldCheck size={12}/>{workspaceMode==='live'?(o.verificationStatus==='verified'?'Business verified':'Business verification not confirmed'):(o.rating||'Demo participant')}</div></td><td><div className="price-value">₹{o.price.toFixed(2)}<span>/{o.unit}</span></div><small className="muted-text">{tr("Final amount based on accepted weight")}</small></td><td><div className="table-primary">{o.pickup}</div><small className="muted-text">{o.note}</small></td><td><StatusPill status={o.status}/></td><td><div className="table-actions">{o.status==='Pending'?<><button className="button small primary" onClick={()=>onAction(o.id,'Accepted')}>{tr('Accept')}</button><button className="button small secondary" onClick={()=>onAction(o.id,'Declined')}>{tr("Decline")}</button></>:<button className="icon-button" aria-label={tr("View batch")} onClick={()=>b&&onBatch(b)}><ChevronRight size={17}/></button>}</div></td></tr>})}</tbody></table>{list.length===0&&<EmptyState title={tr("No offers in this view")} description="Offers will appear here when buyers respond to your material listings."/>}</div></div><div className="notice-strip"><ShieldCheck size={18}/><span><strong>{tr("Compare the full terms.")}</strong> Rates shown here are sample offers. Actual amounts may depend on final accepted weight, condition, transport and agreed terms.</span></div></>}
function ListPage({role,page,batches,search,setSearch,filter,setFilter,onAdd,onBatch,onNotify,onUpdateBatch,onUpdateOffer,offers,onPage}){
  const isBuyer=role==='buyer';const isCollector=role==='collector';const isAdmin=role==='admin';
  const title=page==='My listings'?'My listings':page==='Find material'?'Find material':page==='My sourcing'?'My sourcing':page==='My pickups'?'My pickups':page==='Schedule'?'Collection schedule':page==='Completed jobs'?'Completed jobs':page==='Issues'?'Issues & exceptions':page==='Transactions'?'Transactions':page==='Collections'?'Collections':'Exceptions';
  const description=page==='My listings'?'Manage your material batches, review status and follow each listing through to handover.':page==='Find material'?'Browse available batches and evaluate whether they fit your sourcing requirements.':page==='My pickups'?'Open assigned jobs, confirm the actual weight and record each handover.':page==='Completed jobs'?'Review completed collections and their handover records.':page==='Transactions'?'Search completed transactions and open their supporting records.':page==='My sourcing'?'Track offers, accepted batches and incoming material.':page==='Issues'?'Review collection problems and records that need follow-up.':page==='Schedule'?'Review collection commitments and upcoming assigned jobs.':page==='Collections'?'Track collections that are scheduled or in progress.':'Review records that may need administrative follow-up.';
  const action=role==='generator'&&page==='My listings'?onAdd:null;
  const actionLabel='List material';
  const categories=['All materials','Cardboard','Paper','Plastic'];
  const header=page==='Find material'?'Available supply':isCollector?'Collection jobs':isAdmin?'Operational records':'Material batches';
  return <><PageHeading eyebrow={isBuyer?'MATERIAL SOURCING':isCollector?'COLLECTION OPERATIONS':isAdmin?'PLATFORM OPERATIONS':'MATERIAL MANAGEMENT'} title={title} description={description} action={action} actionLabel={actionLabel} actionIcon={PackagePlus}/>
    <div className="list-toolbar"><div className="search-field"><Search size={17}/><input value={search} onChange={e=>setSearch(e.target.value)} placeholder={isBuyer?'Search material, batch or location':'Search by material, batch or location'} aria-label={tr("Search records")}/>{search&&<button className="icon-button tiny" onClick={()=>setSearch('')} aria-label={tr("Clear search")}><X size={14}/></button>}</div><div className="toolbar-filters"><div className="select-wrap"><Filter size={15}/><select value={filter} onChange={e=>setFilter(e.target.value)} aria-label={tr("Filter by material")}>{categories.map(c=><option key={c}>{c}</option>)}</select><ChevronDown size={14}/></div><button className="button secondary" onClick={()=>{setSearch('');setFilter('All materials')}}><RefreshCw size={14}/> {tr("Reset")}</button></div></div>
    <div className="list-summary"><div><strong>{batches.length} records</strong><span> · {header}</span></div><span className="table-legend"><span><i className="legend-dot green"/> {tr("Current")}</span><span><i className="legend-dot amber"/> {tr("Needs action")}</span></span></div>
    <div className="panel records-panel"><div className="table-wrap"><table className="records-table"><thead><tr><th>{tr("Material / batch")}</th><th>{tr("Quantity")}</th><th>{tr("Location")}</th>{isBuyer&&page==='Find material'&&<th>{tr("Fit")}</th>}<th>{tr("Status")}</th><th>{isBuyer?'Source':isCollector?'Scheduled':'Updated'}</th><th><span className="sr-only">{tr("Open")}</span></th></tr></thead><tbody>{batches.map(b=><tr key={b.id}><td><div className="record-material"><MaterialThumb type={b.photo}/><div><button className="table-primary button-reset" onClick={()=>onBatch(b)}>{b.material}</button><small>{b.id}</small></div></div></td><td><strong>{b.quantity} {b.unit}</strong>{b.actualWeight&&<small className="table-secondary">Final: {b.actualWeight} {b.unit}</small>}</td><td><span className="location-cell"><MapPin size={13}/>{b.location}</span></td>{isBuyer&&page==='Find material'&&<td><span className="match-fit" title={(b.matchReasons||[]).join(' · ')}>{typeof b.matchScore==='number'&&b.matchScore>0?`${b.matchScore}%`: 'Candidate'}</span></td>}<td><StatusPill status={b.status}/></td><td><span className="date-cell">{isBuyer?b.seller:b.date}</span></td><td>{isCollector&&page==='My pickups'&&['Collection scheduled','Collected'].includes(b.status)?<button className="button small primary pickup-quick-action" onClick={async e=>{e.stopPropagation();if(b.status==='Collected'){onBatch(b);return;}try{await onUpdateBatch(b.id,{status:'Collected'});onNotify('Pickup marked collected. Add actual weight and handover evidence to finish.');onBatch({...b,status:'Collected'});}catch(err){onNotify(err.message||'Could not update pickup.');}}}>{b.status==='Collected'?'Finish handover':'Mark collected'} <ArrowRight size={13}/></button>:<button className="icon-button" onClick={()=>onBatch(b)} aria-label={`Open ${b.id}`}><ChevronRight size={17}/></button>}</td></tr>)}</tbody></table>{batches.length===0&&<EmptyState title={tr("No matching records")} description="Try changing the material filter or search terms." action="Clear filters" onAction={()=>{setSearch('');setFilter('All materials')}}/>}</div><div className="table-footer"><span>Showing {batches.length} records in this prototype</span><span className="pagination-disabled"><ChevronLeft size={14}/> {tr("Page 1")}{' '}<ChevronRight size={14}/></span></div></div>
    {isBuyer&&page==='Find material'&&<div className="notice-strip"><SearchCheck size={18}/><span><strong>{tr("Check fit before making an offer.")}</strong> {tr("Confirm material condition, collection distance and final weight terms with the seller.")}</span></div>}
    {isCollector&&<div className="notice-strip"><ClipboardCheck size={18}/><span><strong>{tr("Close every handover.")}</strong> {tr("Record actual weight and evidence only after the collection has taken place.")}</span></div>}
    {isAdmin&&<div className="notice-strip"><ShieldCheck size={18}/><span><strong>{tr("Keep an audit trail.")}</strong> {tr("Administrative actions should preserve the original transaction and record who made each change.")}</span></div>}
  </>
}
function EmptyState({title,description,action,onAction}){return <div className="empty-state"><div className="empty-icon"><Package size={23}/></div><h3>{title}</h3><p>{description}</p>{action&&<button className="button secondary" onClick={onAction}>{action}</button>}</div>}
function NewBatchModal({onClose,onSubmit,template=null,defaultsKey='reloop-listing-defaults:demo'}){
  const base={material:'Corrugated cardboard',category:'Cardboard',quantity:'80',unit:'kg',condition:'Clean, flattened',location:'',date:'',description:''};
  const [form,setForm]=useState(()=>{const saved=loadState(defaultsKey,{});const repeated=template?{material:template.material||base.material,category:template.category||base.category,quantity:String(template.quantity||base.quantity),unit:template.unit||base.unit,condition:template.condition||base.condition,location:template.location||'',date:'',description:template.description||''}:{};return {...base,...saved,...repeated};});const [errors,setErrors]=useState({});
  const set=(k,v)=>setForm(p=>({...p,[k]:v}));
  const submit=e=>{e.preventDefault();const er={};if(!form.quantity||Number(form.quantity)<=0)er.quantity='Enter a quantity greater than zero.';if(!form.location.trim())er.location='Enter the collection location.';if(!form.condition.trim())er.condition='Describe the material condition.';setErrors(er);if(Object.keys(er).length)return;const clean={...form,quantity:Number(form.quantity),location:form.location.trim(),date:form.date||'Collection time to be agreed',description:form.description.trim()};try{localStorage.setItem(defaultsKey,JSON.stringify({...form,quantity:String(form.quantity),location:form.location.trim()}));}catch{}onSubmit(clean)};
  return <div className="modal-backdrop" onMouseDown={e=>e.target===e.currentTarget&&onClose()}><div className="modal-card modal-wide" role="dialog" aria-modal="true" aria-labelledby="new-batch-title"><div className="modal-header"><div><div className="eyebrow">{tr(template?'REPEAT LISTING':'NEW LISTING')}</div><h2 id="new-batch-title">{tr(template?'List this material again':'List recyclable material')}</h2><p>{template?'We copied the previous batch details. Update the quantity and collection timing before publishing.':'Your usual material and location details are remembered on this device. Confirm them before publishing.'}</p></div><button className="icon-button" onClick={onClose} aria-label="Close dialog"><X size={19}/></button></div><form onSubmit={submit}><div className="form-grid"><label className="field full"><span>{tr('Material type')} <b>*</b></span><select value={form.material} onChange={e=>{const material=e.target.value;set('material',material);set('category',material.toLowerCase().includes('paper')?'Paper':material.toLowerCase().includes('plastic')||material.includes('PET')?'Plastic':'Cardboard')}}><option>Corrugated cardboard</option><option>Mixed cardboard</option><option>Office paper</option><option>Mixed paper</option><option>PET bottles</option><option>Rigid plastic</option></select></label><label className="field"><span>{tr('Estimated quantity')} <b>*</b></span><div className="input-with-unit"><input type="number" min="0.1" step="0.1" value={form.quantity} onChange={e=>set('quantity',e.target.value)} aria-invalid={!!errors.quantity}/><select value={form.unit} onChange={e=>set('unit',e.target.value)} aria-label="Quantity unit"><option>kg</option><option>tonnes</option></select></div>{errors.quantity&&<small className="field-error">{errors.quantity}</small>}</label><label className="field"><span>{tr('Material condition')} <b>*</b></span><select value={form.condition} onChange={e=>set('condition',e.target.value)}><option>Clean, flattened</option><option>Sorted, dry</option><option>Mixed, needs sorting</option><option>Bundled</option><option>Other — describe below</option></select></label><label className="field full"><span>{tr('Collection location')} <b>*</b></span><div className="input-icon"><MapPin size={16}/><input value={form.location} onChange={e=>set('location',e.target.value)} placeholder={tr("Area or city; full address can be shared after assignment")} aria-invalid={!!errors.location}/></div>{errors.location&&<small className="field-error">{errors.location}</small>}</label><label className="field full"><span>{tr('Collection preference')}</span><input value={form.date} onChange={e=>set('date',e.target.value)} placeholder="e.g. Weekdays, 10 AM–4 PM"/></label><label className="field full"><span>{tr('Additional details')} <small>{tr('Optional')}</small></span><textarea value={form.description} onChange={e=>set('description',e.target.value)} placeholder={tr("Anything a buyer should know about the batch?")} rows="3"/></label></div><div className="form-note"><ShieldCheck size={16}/><span>Quantity is an estimate. Final weight and commercial terms should be confirmed during the transaction.</span></div><div className="modal-actions"><button type="button" className="button secondary" onClick={onClose}>{tr('Cancel')}</button><button type="submit" className="button primary"><PackagePlus size={16}/> {tr('Publish listing')} <ArrowRight size={15}/></button></div></form></div></div>
}
function BatchModal({batch,role,offers,onClose,onUpdate,onOffer,onDuplicate,notify,liveMode=false,onEvidence}){
 const [weight,setWeight]=useState(batch.actualWeight?String(batch.actualWeight):'');const [price,setPrice]=useState(batch.price?String(batch.price):'');const [note,setNote]=useState('');const [pickup,setPickup]=useState('Within 3 business days');const [evidence,setEvidence]=useState(false);const [evidenceFile,setEvidenceFile]=useState(null);const [confirm,setConfirm]=useState(false);const [collectors,setCollectors]=useState([]);const [collectorId,setCollectorId]=useState('');useEffect(()=>{if(role==='admin'&&liveMode){apiRequest('/admin/partners').then(d=>setCollectors((d.partners||[]).filter(p=>p.role==='collector'&&p.verificationStatus!=='rejected'))).catch(()=>{});}},[role,liveMode]);
 const nextStatus=batch.status==='Listed'?'Offer received':batch.status==='Offer received'?'Collection scheduled':batch.status==='Collection scheduled'?'Collected':batch.status==='Collected'?'Completed':null;
 const updateStatus=async()=>{if(batch.status==='Collected'&&(!weight||Number(weight)<=0)){notify('Enter a valid actual weight before completing.');return}if(batch.status==='Collected'&&!evidence){notify('Confirm handover evidence before completing.');return}if(batch.status==='Collected'&&liveMode&&!evidenceFile){notify('Upload a JPG, PNG or PDF handover file before completing.');return}try{if(batch.status==='Collected'&&liveMode&&evidenceFile)await onEvidence(batch.id,evidenceFile);await onUpdate(batch.id,{status:nextStatus,actualWeight:batch.status==='Collected'?Number(weight):batch.actualWeight,price:price?Number(price):batch.price});notify(`Batch ${batch.id} updated to ${nextStatus}.`);setConfirm(false);return true;}catch(err){notify(err.message||'Could not update the transaction.');return false;}};
 const canCollect=role==='collector'&&['Collection scheduled','Collected'].includes(batch.status);const canGenerator=role==='generator';const canBuyer=role==='buyer';
 return <div className="modal-backdrop" onMouseDown={e=>e.target===e.currentTarget&&onClose()}><div className="modal-card modal-wide" role="dialog" aria-modal="true" aria-labelledby="batch-title"><div className="modal-header"><div><div className="eyebrow">BATCH {batch.id}</div><h2 id="batch-title">{batch.material}</h2><p>{batch.seller} · {batch.location}</p></div><button className="icon-button" onClick={onClose} aria-label="Close batch details"><X size={19}/></button></div><div className="batch-detail-summary"><MaterialThumb type={batch.photo}/><div className="batch-detail-main"><div className="detail-topline"><StatusPill status={batch.status}/><span className="batch-id">Created {batch.date}</span></div><div className="detail-quantity">{batch.quantity} {batch.unit}<span> estimated</span></div><div className="detail-meta"><span><MapPin size={14}/>{batch.location}</span><span><Boxes size={14}/>{batch.condition}</span></div></div></div><div className="detail-description">{batch.description||'No additional material details provided.'}</div><div className="detail-section"><h3>{tr("Transaction progress")}</h3><div className="progress-track">{['Listed','Offer received','Collection scheduled','Collected','Completed'].map((s,i)=>{const order=['Listed','Offer received','Collection scheduled','Collected','Completed'].indexOf(batch.status);return <div className={`progress-step ${i<=order?'done':''}`} key={s}><span>{i<order?<Check size={13}/>:i+1}</span><small>{s}</small></div>})}</div></div><div className="detail-grid"><div className="detail-fact"><span>{tr("Agreed price")}</span><strong>{batch.price?`₹${Number(batch.price).toFixed(2)} / ${batch.unit}`:'Not agreed yet'}</strong></div><div className="detail-fact"><span>{tr("Actual weight")}</span><strong>{batch.actualWeight?`${batch.actualWeight} ${batch.unit}`:'Pending confirmation'}</strong></div><div className="detail-fact"><span>{tr("Collection partner")}</span><strong>{batch.collector||'Not assigned'}</strong></div><div className="detail-fact"><span>{tr("Record type")}</span><strong>{liveMode?'Shared record':'Prototype sample'}</strong></div></div>
 {offers.length>0&&<div className="detail-section"><h3>{tr("Offers on this batch")}</h3>{offers.map(o=><div className="offer-mini" key={o.id}><div><strong>{o.buyer}</strong><small>{o.pickup} · {o.status}</small></div><div className="offer-mini-price">₹{o.price.toFixed(2)}<small>/ {o.unit||batch.unit}</small></div>{role==='generator'&&o.status==='Pending'&&<button className="button small primary" onClick={()=>onOffer(o.id,'Accepted')}>{tr("Accept")}</button>}</div>)}</div>}
 {canCollect&&<div className="detail-section handover-box"><h3>{batch.status==='Collected'?'Complete handover record':'Collection actions'}</h3>{batch.status==='Collection scheduled'?<><p>After collection, record the accepted quantity and update the job status.</p><button className="button primary" onClick={async()=>{try{await onUpdate(batch.id,{status:'Collected'});notify('Pickup marked as collected. Add the final weight and evidence to complete the record.')}catch{}}}><Truck size={16}/> {tr('Mark as collected')}</button></>:<><label className="field"><span>{tr('Actual weight')} ({batch.unit}) <b>*</b></span><input type="number" min="0.1" step="0.1" value={weight} onChange={e=>setWeight(e.target.value)}/></label><label className="checkbox-field"><input type="checkbox" checked={evidence} onChange={e=>setEvidence(e.target.checked)}/><span>{tr('Handover evidence has been checked and recorded.')}</span></label>{liveMode&&<label className="field"><span>Upload handover evidence (JPG, PNG or PDF) *</span><input type="file" accept="image/jpeg,image/png,application/pdf" capture="environment" onChange={e=>setEvidenceFile(e.target.files?.[0]||null)}/><small>Maximum 6 MB. File is stored with the transaction.</small></label>}<button className="button primary" onClick={()=>{if(!weight||Number(weight)<=0){notify('Enter a valid actual weight.');return}if(!evidence){notify('Confirm handover evidence first.');return}if(liveMode&&!evidenceFile){notify('Upload handover evidence first.');return}setConfirm(true)}}><CheckCircle2 size={16}/> {tr('Confirm handover')}</button></>}</div>}
 {role==='admin'&&liveMode&&['Offer accepted','Collection scheduled'].includes(batch.status)&&<div className="detail-section handover-box"><h3>{tr("Assign collection partner")}</h3><p>{tr("Only assign a registered collector account. The collector will receive an in-app notification.")}</p><label className="field"><span>{tr("Collector account")}</span><select value={collectorId} onChange={e=>setCollectorId(e.target.value)}><option value="">{tr("Choose a collector")}</option>{collectors.map(c=><option key={c.id} value={c.id}>{c.businessName} · {c.verificationStatus}</option>)}</select></label><button className="button primary" disabled={!collectorId} onClick={async()=>{try{await onUpdate(batch.id,{collectorId});notify('Collector assigned and pickup scheduled.');}catch{}}}><Truck size={16}/> {tr("Assign collector")}</button></div>}
 {canBuyer&&['Listed','Offer received'].includes(batch.status)&&<div className="detail-section handover-box"><h3>{tr("Interested in this batch?")}</h3><p>Review condition, collection location and terms before making a commitment. {liveMode?'Your offer will be sent to the listing owner.':'Offers in demo mode are not sent to real businesses.'}</p><label className="field"><span>{tr('Your offer rate')} (₹ / {batch.unit})</span><input type="number" min="0" step="0.25" value={price} onChange={e=>setPrice(e.target.value)} placeholder={tr("Enter proposed rate")}/></label><label className="field"><span>{tr('Preferred collection')}</span><select value={pickup} onChange={e=>setPickup(e.target.value)}><option>{tr("Within 24 hours")}</option><option>{tr("Within 3 business days")}</option><option>{tr("Flexible — agree with seller")}</option></select></label><label className="field"><span>{tr('Offer note')} <small>{tr('Optional')}</small></span><textarea rows="2" value={note} onChange={e=>setNote(e.target.value)} placeholder={tr("Only add special conditions if needed")}/></label><button className="button primary" onClick={()=>{if(!price||Number(price)<=0){notify('Enter a valid offer rate.');return}onOffer(batch.id,'create',{price:Number(price),note,pickup});}}>{liveMode?tr('Submit offer'):tr('Prepare demo offer')} <ArrowRight size={15}/></button></div>}
 {canGenerator&&<div className="detail-section handover-box"><h3>{batch.status==='Completed'?'List this material again':'Next step'}</h3><p>{batch.status==='Completed'?'Reuse the material, condition and location details to create a fresh listing.': 'Review offers as they arrive; a collection is not booked until terms and scheduling are confirmed.'}</p><div className="confirm-inline"><button className="button secondary" onClick={()=>notify(liveMode?'Your listing is visible to other signed-in buyer accounts.':'This sample listing is visible in the demo buyer workspace.')}><Eye size={16}/> {tr("Preview visibility")}</button><button className="button primary" onClick={()=>onDuplicate(batch)}><RefreshCw size={15}/> {tr("Use as template")}</button></div></div>}
 <div className="modal-actions"><button className="button secondary" onClick={onClose}>{tr('Close details')}</button>{confirm&&<div className="confirm-inline"><span>{tr("Complete this handover?")}</span><button className="button small secondary" onClick={()=>setConfirm(false)}>{tr("Cancel")}</button><button className="button small primary" onClick={async()=>{const done=await updateStatus();if(done)onClose()}}>{tr("Confirm")}</button></div>}</div></div></div>
}
function IssuePage({liveMode,role,user,batches,notify}) {
  const [category,setCategory]=useState('Missed pickup'); const [description,setDescription]=useState(''); const [batchId,setBatchId]=useState('');
  const [issues,setIssues]=useState(()=>loadState('reloop-demo-issues',[])); const [loading,setLoading]=useState(false); const [error,setError]=useState(''); const [submitted,setSubmitted]=useState(null);
  const refresh=async()=>{setLoading(true);setError('');try{const d=await apiRequest(role==='admin'?'/admin/issues':'/issues/mine');setIssues(d.issues||[])}catch(e){setError(e.message)}finally{setLoading(false)}};
  useEffect(()=>{if(liveMode)refresh()},[liveMode,role]);
  const submit=async(e)=>{e.preventDefault();setError('');if(description.trim().length<5){setError('Please describe the issue in a few words.');return}setLoading(true);try{let created;if(liveMode){const d=await apiRequest('/issues',{method:'POST',body:JSON.stringify({category,description:description.trim(),batchId:batchId||null,language:detectLanguage()})});created=d.issue;await refresh()}else{created={id:`DEMO-ISS-${Date.now().toString().slice(-6)}`,category,description:description.trim(),batchId:batchId||null,status:'open',createdAt:new Date().toISOString(),demo:true};const next=[created,...issues];setIssues(next);localStorage.setItem('reloop-demo-issues',JSON.stringify(next));}setSubmitted(created);setDescription('');setBatchId('');notify(`Issue ${created.id} recorded${liveMode?' on the shared workspace':' in this browser demo'}.`)}catch(e){setError(e.message)}finally{setLoading(false)}};
  const changeStatus=async(issue,status)=>{try{await apiRequest(`/admin/issues/${encodeURIComponent(issue.id)}`,{method:'PATCH',body:JSON.stringify({status})});await refresh();notify(`Issue ${issue.id} updated.`)}catch(e){setError(e.message)}};
  return <><PageHeading eyebrow={role==='admin'?'SUPPORT OPERATIONS':'HELP & SUPPORT'} title={role==='admin'?'Issues':'Report an issue'} description={role==='admin'?'Review reported problems and update their resolution status.':'Report a missed pickup, incorrect weight, pricing concern, safety issue or technical problem.'}/>
    {submitted&&<div className="issue-success" role="status"><CheckCircle2 size={20}/><div><strong>{tr('Report received')}</strong><p>Your reference: <b>{submitted.id}</b>. Keep this reference if you need to follow up.</p></div><button className="icon-button" onClick={()=>setSubmitted(null)} aria-label="Dismiss confirmation"><X size={16}/></button></div>}
    {role!=='admin'&&<form className="panel issue-form" onSubmit={submit}><div className="panel-header"><div><h3>{tr("Tell us what happened")}</h3><span>{tr("Only share information needed to resolve the issue. You can write in your preferred language.")}</span></div><span className="soft-icon"><MessageSquareText size={18}/></span></div><div className="form-grid"><label className="field full"><span>{tr('Issue category')} *</span><select value={category} onChange={e=>setCategory(e.target.value)}><option>{tr("Missed pickup")}</option><option>{tr("Incorrect weight")}</option><option>{tr("Pricing disagreement")}</option><option>{tr("Suspected fraud")}</option><option>{tr("Safety concern")}</option><option>{tr("Technical problem")}</option><option>{tr("Language or accessibility")}</option><option>{tr("Other")}</option></select></label><label className="field full"><span>{tr("Related material batch (optional)")}</span><select value={batchId} onChange={e=>setBatchId(e.target.value)}><option value="">{tr("No specific batch")}</option>{batches.map(b=><option key={b.id} value={b.id}>{b.id} · {b.material}</option>)}</select></label><label className="field full"><span>{tr('Description')} *</span><textarea required minLength={5} maxLength={2000} rows={4} value={description} onChange={e=>setDescription(e.target.value)} placeholder="Describe the issue in your own words. Local language is welcome."/><small>{description.length}/2000 · Do not include passwords or unnecessary personal information.</small></label></div>{error&&<div className="auth-error" role="alert">{error}</div>}<div className="modal-actions"><button className="button primary" disabled={loading||!description.trim()}><Send size={15}/>{loading?'Sending…':tr('Submit report')}</button></div><div className="verification-privacy"><ShieldCheck size={16}/><span>{tr("Reports are visible to authorized support staff. Live reports are stored on the server; demo reports stay in this browser only.")}</span></div></form>}
    <div className="panel issue-list-panel"><div className="panel-header"><div><h3>{role==='admin'?'Reported issues':'Your reports'}</h3><span>{liveMode?'Shared server records': 'Demo records from this browser'}</span></div><button className="button small secondary" onClick={liveMode?refresh:()=>setIssues(loadState('reloop-demo-issues',[]))} disabled={loading}><RefreshCw size={14}/> {tr("Refresh")}</button></div>{error&&role==='admin'&&<div className="auth-error">{error}</div>}{loading&&<div className="inline-loading">{tr("Loading reports…")}</div>}{issues.length===0&&!loading?<EmptyState title={tr("No issues reported yet")} description="When a problem is reported, its reference and status will appear here."/>:<div className="table-wrap"><table><thead><tr><th>{tr("Reference")}</th><th>{tr("Category")}</th><th>{tr("Status")}</th><th>{tr("Reported")}</th>{role==='admin'&&<th>{tr("Action")}</th>}</tr></thead><tbody>{issues.map(issue=><tr key={issue.id}><td><div className="table-primary">{issue.id}</div><small className="muted-text">{issue.description}</small></td><td>{issue.category}</td><td><StatusPill status={issue.status==='open'?'Needs review':issue.status==='in_review'?'In review':issue.status==='resolved'?'Completed':'Cancelled'}/></td><td>{issue.createdAt?new Date(issue.createdAt).toLocaleString(languageLocale(detectLanguage())):'—'}</td>{role==='admin'&&<td><select aria-label={`Update ${issue.id} status`} value={issue.status} onChange={e=>changeStatus(issue,e.target.value)}><option value="open">{tr("Open")}</option><option value="in_review">In review</option><option value="resolved">{tr("Resolved")}</option><option value="closed">{tr("Closed")}</option></select></td>}</tr>)}</tbody></table></div>}</div>
  </>;
}

function InfoModal({title,onClose,children}){return <div className="modal-backdrop" onMouseDown={e=>e.target===e.currentTarget&&onClose()}><div className="modal-card" role="dialog" aria-modal="true" aria-labelledby="info-title"><div className="modal-header"><div><h2 id="info-title">{title}</h2></div><button className="icon-button" onClick={onClose} aria-label="Close dialog"><X size={19}/></button></div><div className="info-modal-body">{children}</div></div></div>}
function PartnersPage({notify,liveMode=false}){const [tab,setTab]=useState('All partners');const [partners,setPartners]=useState([['Northstar Retail','Material generator','Business profile complete','green'],['Pune Fibre Works','Buyer / recycler','Verified for demo','green'],['GreenRoute Collection','Collector / logistics','Profile complete','green'],['Westline Recyclers','Buyer / recycler','Review required','amber']]);const [loading,setLoading]=useState(false);const refresh=async()=>{setLoading(true);try{const data=await apiRequest('/admin/partners');setPartners(data.partners||[])}catch(err){notify(err.message)}finally{setLoading(false)}};useEffect(()=>{if(liveMode)refresh()},[liveMode]);const changeVerification=async(p,status)=>{try{await apiRequest(`/admin/partners/${encodeURIComponent(p.id)}/verification`,{method:'PATCH',body:JSON.stringify({status})});notify(`Partner marked ${status}.`);await refresh()}catch(err){notify(err.message)}};const rows=liveMode?partners.filter(p=>tab==='All partners'||(tab==='Generators'&&p.role==='generator')||(tab==='Buyers'&&p.role==='buyer')||(tab==='Collectors'&&p.role==='collector')):partners.filter(p=>tab==='All partners'||p[1].toLowerCase().includes(tab.slice(0,-1).toLowerCase())||(tab==='Buyers'&&p[1].includes('Buyer')));return <><PageHeading eyebrow="PARTNER OPERATIONS" title={tr("Partners")} description="Review participant profiles and business verification status."/><div className="tab-row">{['All partners','Generators','Buyers','Collectors'].map(t=><button key={t} className={`tab-button ${tab===t?'active':''}`} onClick={()=>setTab(t)}>{t}</button>)}</div><div className="panel"><div className="table-wrap"><table><thead><tr><th>{tr("Partner")}</th><th>Role</th><th>{tr("Verification")}</th><th>{tr("Actions")}</th></tr></thead><tbody>{rows.map((p,i)=>{const name=liveMode?p.businessName:p[0];const roleName=liveMode?({generator:'Material generator',buyer:'Buyer / recycler',collector:'Collector / logistics',admin:'Platform admin'}[p.role]||p.role):p[1];const status=liveMode?p.verificationStatus:p[2];return <tr key={liveMode?p.id:name}><td><div className="table-primary">{name}</div><small className="muted-text">{liveMode?p.email:'Demo partner profile'}</small>{liveMode&&p.verificationEvidence?.map(e=><a className="verification-file-link" key={e.id} href={`/api/admin/partners/${encodeURIComponent(p.id)}/evidence/${encodeURIComponent(e.id)}`} target="_blank" rel="noreferrer">View {e.documentType.replaceAll('_',' ')}</a>)}</td><td>{roleName}</td><td><span className={`status-pill ${status==='verified'||status==='Verified for demo'||status==='Business profile complete'?'completed':status==='rejected'?'cancelled':'pending'}`}><i/>{status}</span></td><td>{liveMode&&p.role!=='admin'?<div className="table-actions"><button className="button small primary" onClick={()=>changeVerification(p,'verified')}>{tr("Verify")}</button><button className="button small secondary" onClick={()=>changeVerification(p,'rejected')}>{tr("Reject")}</button></div>:<span className="muted-text">{liveMode?'System account':'Demo data'}</span>}</td></tr>})}</tbody></table>{loading&&<div className="inline-loading">{tr("Refreshing partner records…")}</div>}{rows.length===0&&!loading&&<EmptyState title={tr("No partners in this view")} description="New business accounts will appear here."/>}</div></div><div className="notice-strip"><ShieldCheck size={18}/><span><strong>{tr("Verification is a manual decision.")}</strong> {tr("Verify only after checking the business details and supporting evidence. Account creation alone is not verification.")}</span></div></>}
function AuditPage({batches,liveMode=false}){const [records,setRecords]=useState([]);const [error,setError]=useState('');useEffect(()=>{if(liveMode)apiRequest('/admin/audit').then(d=>setRecords(d.audit||[])).catch(e=>setError(e.message))},[liveMode]);const rows=liveMode?records:batches.slice(0,5).map((b,i)=>({id:b.id,action:b.status,entityType:'batch',entityId:b.id,details:{material:b.material,seller:b.seller},createdAt:b.date}));return <><PageHeading eyebrow="PLATFORM GOVERNANCE" title={tr("Audit log")} description="Review recorded workflow events and administrative actions."/><div className="panel"><div className="panel-header"><div><h3>{tr("Recent activity")}</h3><span>{liveMode?'Server-recorded events':'Illustrative records from the demo workspace'}</span></div><span className="soft-icon"><FileText size={17}/></span></div>{error&&<div className="auth-error">{error}</div>}<div className="audit-list">{rows.slice(0,100).map((r,i)=><div className="audit-row" key={r.id||i}><div className="audit-marker"><Activity size={15}/></div><div className="audit-copy"><strong>{r.action||'Activity'}: {r.entityType||'record'} {r.entityId||''}</strong><p>{typeof r.details==='object'?JSON.stringify(r.details):String(r.details||'')}</p></div><span className="audit-time">{r.createdAt?new Date(r.createdAt).toLocaleString(languageLocale(detectLanguage())):'—'}</span></div>)}{rows.length===0&&!error&&<EmptyState title={tr("No recorded activity yet")} description="Actions will appear here as the platform is used."/>}</div></div><div className="notice-strip"><AlertCircle size={18}/><span><strong>{tr("Audit records are server-generated.")}</strong> {tr("Sensitive changes preserve actor, timestamp and relevant transaction context.")}</span></div></>}

if ('serviceWorker' in navigator && import.meta.env.PROD) window.addEventListener('load',()=>navigator.serviceWorker.register('/sw.js').catch(()=>{}));
createRoot(document.getElementById('root')).render(<App/>);
